<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    body {
      font-family: Helvetica, sans-serif;
      font-size: 9pt;
      margin: 0;
      padding: 10px;
    }

    .page {
      width: 100%;
      height: 100%;
      page-break-after: always;
    }

    .boleto {
      width: 100%;
      border: 1px solid black;
      margin-bottom: 4px;
      height: 150px;
      overflow: hidden;
      display: table; /* simulamos row */
    }

    .column, .column-right {
      display: table-cell;
      width: 50%;
      vertical-align: top;
      padding: 6px;
      box-sizing: border-box;
    }

    .column {
      border-right: 1px solid black;
    }

    .right-top {
      text-align: right;
      font-size: 8pt;
    }

    .footer {
      font-size: 7pt;
      margin-top: 4px;
    }
  </style>
</head>
<body>
  <% 
    // agrupar boletos en páginas de 5
    const chunked = [];
    for (let i = 0; i < boletos.length; i += 5) {
      chunked.push(boletos.slice(i, i + 5));
    }
  %>

  <% chunked.forEach((grupo) => { %>
    <div class="page">
      <% grupo.forEach((boleto) => { %>
        <div class="boleto">
          <!-- Columna izquierda -->
          <div class="column">
            <div><%= boleto.Fecha || "----" %></div>
            <div>LUNES</div>
            <div>BALCONES DE LA CANTERA</div>
            <div><%= boleto.Titular %></div>
            <div><%= boleto.Giro %></div>
            <div><%= boleto.Ubicacion %></div>
            <div><%= boleto.Cuota.toFixed(2) %></div>
            <div><%= (boleto.Cuota*9).toFixed(2) %></div>
            <div><%= (boleto.Cuota*6).toFixed(2) %></div>
            <div><%= (boleto.Cuota*15).toFixed(2) %></div>
          </div>

          <!-- Columna derecha -->
          <div class="column-right">
            <div class="right-top">Redondeo Art. 17 LIMZ 2021</div>
            <div><%= boleto.Fecha || "----" %></div>
            <div>LUNES</div>
            <div>BALCONES DE LA CANTERA</div>
            <div>AMPARA UNICAMENTE EL USO DE PISO</div>
            <div><%= boleto.Titular %></div>
            <div><%= boleto.Giro %></div>
            <div><%= boleto.Ubicacion %></div>
            <div><%= boleto.Cuota.toFixed(2) %></div>
            <div><%= (boleto.Cuota*9).toFixed(2) %></div>
            <div><%= (boleto.Cuota*6).toFixed(2) %></div>
            <div><%= (boleto.Cuota*15).toFixed(2) %></div>
            <div class="footer">
              Art. 100. El presente boleto representa la asistencia del tianguista por este día.
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% }) %>
</body>
</html>
