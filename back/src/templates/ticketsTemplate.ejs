<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <style>
    @page {
      size: letter;
      margin: 0;
    }
    body {
      font-family: Arial, sans-serif;
      font-size: 9pt;
      margin: 0;
      padding: 0.5cm;
    }
    .page {
      display: grid;
      grid-template-columns: 1fr 1fr;
      grid-template-rows: repeat(5, 1fr);
      gap: 0.2cm 0.5cm;
      height: 26.5cm;
      width: 20.5cm;
      margin: auto;
    }
    .boleto {
      border: 1px dashed transparent; /* guía opcional */
      width: 9.8cm;
      height: 5.1cm;
      padding: 0.3cm;
      box-sizing: border-box;
    }
    .folio {
      color: red;
      font-weight: bold;
      font-size: 12pt;
    }
    .small {
      font-size: 8pt;
    }
  </style>
</head>
<body>
  <% 
    function formatDate(fechaStr) {
      if (!fechaStr) return '';
      const fecha = new Date(fechaStr);
      const d = String(fecha.getDate()).padStart(2, '0');
      const m = String(fecha.getMonth()+1).padStart(2, '0');
      const y = fecha.getFullYear();
      return `${d}/${m}/${y}`;
    }
    const boletosPorPagina = 10;
    for (let i = 0; i < boletos.length; i += boletosPorPagina) {
      const paginaBoletos = boletos.slice(i, i + boletosPorPagina);
  %>
    <div class="page">
      <% paginaBoletos.forEach(boleto => { %>
        <div class="boleto">
          <p><strong>Fecha:</strong> <%= formatDate(boleto.Fecha) %></p>
          <p><strong>Día:</strong> <%= boleto.Dia || '' %></p>
          <p><strong>Tianguis:</strong> <%= boleto.Tianguis || '' %></p>
          <p><strong>Ubicación:</strong> <%= boleto.Ubicacion || '' %></p>
          <p><strong>Titular:</strong> <%= boleto.Titular || '' %></p>
          <p><strong>Giro:</strong> <%= boleto.Giro || '' %></p>
          <p><strong>No. Cred:</strong> <%= boleto.Credencial || '' %></p>
          <p><strong>No. Puesto:</strong> <%= boleto.Puesto || '' %></p>
          <p><strong>Longitud:</strong> <%= boleto.Longitud || '' %> m</p>
          <p><strong>Folio:</strong> <span class="folio"><%= boleto.Folio %></span></p>
        </div>
      <% }) %>
    </div>
    <div style="page-break-after: always;"></div>
  <% } %>
</body>
</html>