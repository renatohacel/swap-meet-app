<!DOCTYPE html>
<html lang="es-MX">

<head>
    <meta charset="UTF-8">
</head>
<style>
    body {
        font-family: Arial, sans-serif;
        font-size: 8pt;
        margin: 0;
        padding: 0.5cm;
        /* Margen uniforme en toda la página */
        box-sizing: border-box;
    }

    .card-container {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.5cm;
        /* Espacio entre las dos tarjetas */
        line-height: 0.5;
        margin-bottom: 0.8cm;
        /* Espacio entre cada par de tarjetas */
        page-break-inside: avoid;
        justify-items: center;
        /* Centra las tarjetas horizontalmente */
    }

    .card-front,
    .card-info {
        width: 9.5cm;
        height: 5.8cm;
        background-size: cover;
        background-position: center;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 0.3cm;
        color: white;
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    }

    .qr-code {
        position: absolute;
        bottom: 3.13cm;
        right: 3.62cm;
        width: 2cm;
        height: 2cm;
        background: white;
        padding: 0.1cm;
        border-radius: 0.1cm;
    }

    .qr-code img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    /* Última tarjeta sin margen inferior */
    .card-container:last-child {
        margin-bottom: 0;
    }
</style>

<body>
    <% cards.forEach((card, index)=> { %>
        <div class="card-container">
            <!-- Frente de la tarjeta -->
            <div class="card-front" style="background-image: url('<%= card.frontImage %>');">
                <!-- QR Code en la esquina inferior derecha -->

            </div>

            <!-- Reverso/Info de la tarjeta -->
            <div class="card-info" style="background-image: url('<%= card.infoImage %>');">
                <div>
                    <div class="qr-code">
                        <img src="<%= card.qrCode %>" alt="QR Code">
                    </div>
                    <div style="
                        font-size: 12pt;
                        font-weight: bold;
                        margin-top: 0.9cm
                    ">
                        <%= card.NumerodeTarjeta %>
                    </div>
                </div>
            </div>
        </div>
        <% }); %>
</body>

</html>